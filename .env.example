# ── AuthSec configuration ─────────────────────────────────────────────────────
# Copy to .env and fill in values from your AuthSec application registration.
# Never commit the populated .env file.

# Required: issued by AuthSec when you register the resource server.
AUTHSEC_RESOURCE_SERVER_ID=<uuid-from-authsec-dashboard>

# Required: one-time secret shown once at registration time.
# Store in a secret manager (Railway secret, AWS SSM, etc.).
AUTHSEC_INTROSPECTION_CLIENT_SECRET=<one-time-secret>

# introspection_client_id == resource_server_id for AuthSec resource servers.
AUTHSEC_INTROSPECTION_CLIENT_ID=<same-uuid-as-resource_server_id>

# These are hardcoded to dev.api.authsec.dev defaults in server.py.
# Override here only if your tenant is on a different domain.
# AUTHSEC_ISSUER=https://dev.api.authsec.dev
# AUTHSEC_AUTHORIZATION_SERVER=https://dev.api.authsec.dev
# AUTHSEC_JWKS_URL=https://dev.api.authsec.dev/oauth/jwks
# AUTHSEC_INTROSPECTION_URL=https://dev.api.authsec.dev/oauth/introspect
# AUTHSEC_RESOURCE_URI=https://authsec-mcp-production.up.railway.app/mcp
# AUTHSEC_RESOURCE_NAME=mcp

# ── GitHub credentials ────────────────────────────────────────────────────────
# Personal access token (classic) or fine-grained PAT.
# Stored server-side only — never forwarded to MCP clients.
GITHUB_TOKEN=ghp_...

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8000

# Set to "false" to disable AuthSec (development smoke-test only).
# AUTHSEC_ENABLED=true
