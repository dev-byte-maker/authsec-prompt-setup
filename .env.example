# ──────────────────────────────────────────────────────────────────────────────
# AuthSec protected-resource configuration
# Copy these values from the AuthSec Applications panel after registering
# "prompt-setup" as a resource server.
# ──────────────────────────────────────────────────────────────────────────────

# AuthSec OAuth issuer (the authorization server)
AUTHSEC_ISSUER=https://dev.api.authsec.dev
AUTHSEC_AUTHORIZATION_SERVER=https://dev.api.authsec.dev

# JWKS and introspection endpoints
AUTHSEC_JWKS_URL=https://dev.api.authsec.dev/oauth/jwks
AUTHSEC_INTROSPECTION_URL=https://dev.api.authsec.dev/oauth/introspect

# Introspection credentials — both values are your resource server UUID.
# The secret is the one-time value generated at registration; store it in a
# secret manager, never in source control.
AUTHSEC_INTROSPECTION_CLIENT_ID=<your-resource-server-uuid>
AUTHSEC_INTROSPECTION_CLIENT_SECRET=<one-time-secret-from-authsec-panel>

# Resource server identity
AUTHSEC_RESOURCE_URI=https://authsec-prompt-mcp-production.up.railway.app/mcp
AUTHSEC_RESOURCE_NAME=prompt-setup
AUTHSEC_RESOURCE_SERVER_ID=<your-resource-server-uuid>

# SDK policy settings
AUTHSEC_POLICY_MODE=remote_required
AUTHSEC_VALIDATION_MODE=jwt_and_introspect
AUTHSEC_PUBLISH_MANIFEST=true

# ──────────────────────────────────────────────────────────────────────────────
# Server
# ──────────────────────────────────────────────────────────────────────────────
PORT=8000
